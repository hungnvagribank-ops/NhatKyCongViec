# Sao chép file này thành ".env" khi chạy ở máy cá nhân (không cần khi deploy trên Render,
# vì Render sẽ tự cấu hình các biến này qua mục Environment trong dashboard).

# Chuỗi kết nối PostgreSQL (Render tự cấp khi bạn tạo PostgreSQL và liên kết vào Web Service)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Chuỗi bí mật dùng để ký token đăng nhập — đặt một chuỗi ngẫu nhiên, dài, giữ bí mật
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-ngau-nhien-va-dai

# Cổng chạy server (Render tự cấp qua biến PORT, không cần khai báo khi deploy)
PORT=3000
